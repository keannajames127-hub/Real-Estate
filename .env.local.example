# ---------------------------------------------------------------------------
# Danish Home Properties — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local` to source control.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key. SERVER-ONLY. Never expose to the browser.
# Used for: public enquiry inserts, storage uploads, and admin user provisioning.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and canonical/SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key for enquiry notification emails (optional).
# If omitted, enquiries are still saved to the database — only the email is skipped.
RESEND_API_KEY=

# "From" address for notification emails. Must be a verified sender/domain in Resend.
RESEND_FROM_EMAIL="Danish Home Properties <notifications@danishhomeproperties.com>"

# Fallback recipient for enquiry notifications. Can be overridden at runtime in
# Admin -> Settings -> Notification email.
NOTIFICATION_EMAIL=
